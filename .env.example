# Copy this file to .env and fill in your values
# DO NOT commit .env to Git

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinema_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SPRING_DATASOURCE_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=${DB_USERNAME}
SPRING_DATASOURCE_PASSWORD=${DB_PASSWORD}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
JWT_TOKEN_CLEANUP_RATE_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GENERAL_REQUESTS=100
RATE_LIMIT_GENERAL_WINDOW_SECONDS=60
LOGGING_LEVEL_ROOT=INFO

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- Bakong / KHQR Payment ----
BAKONG_ACCOUNT_ID=cinema_official@dev
BAKONG_TOKEN=your_bakong_developer_token
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_MERCHANT_NAME=Cinema Booking System
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD
BAKONG_MOCK_MODE=true

Url = http://localhost:8081/swagger-ui/index.html
