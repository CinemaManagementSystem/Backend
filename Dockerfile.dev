FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Keep application deadlines consistent with the business timezone in every environment.
ENV TZ=Asia/Phnom_Penh
ENV JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Phnom_Penh

# Pre-cache Maven dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -B || true

# Expose server port and remote debug port
EXPOSE 8081 5005

# Run with Spring Boot live-reload enabled
ENTRYPOINT ["mvn", "spring-boot:run"]
