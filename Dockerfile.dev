FROM maven:3.9-eclipse-temurin-21

WORKDIR /app

# Keep application deadlines consistent with the business timezone in every environment.
ENV TZ=Asia/Phnom_Penh
ENV JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Phnom_Penh

# Pre-cache Maven dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -B || true

# Expose server port and remote debug port
EXPOSE 8081 5005

# Always rebuild from a clean target directory. The project source is bind-mounted
# in development, so stale or partially-written class files can otherwise survive
# container restarts and crash Spring Boot's classpath scanner.
#
# Launch the repackaged jar directly instead of keeping Maven as the application
# process. This gives Docker the real Java process for signals and health checks.
ENTRYPOINT ["sh", "-c", "find /app/target -mindepth 1 -delete && mvn -B -DskipTests package && exec java -jar target/cinema_project-0.0.1-SNAPSHOT.jar"]
